.next
node_modules
.env
.env.local
dist
coverage

# Caché del CLI de Supabase
supabase/.temp/

# Scripts sueltos de análisis y migración de datos. Este repo es público y
# estos archivos suelen quedar con nombres, teléfonos y domicilios de clientes
# reales, así que se ignoran de entrada para que un `git add -A` no los suba.
# Si algún día hace falta versionar un script de verdad, sacar `scripts/` de
# acá o exceptuarlo con `!scripts/<archivo>`.
.tmp-*
# Va `scripts/*` y no `scripts/`: git no entra a un directorio ignorado, asi que
# con la forma de directorio las excepciones de abajo no se aplicarian nunca.
scripts/*

# Excepcion: las herramientas del bot y de los canales no llevan datos de
# clientes. Son operativas y hacen falta para trabajar (simular conversaciones,
# renovar el token de Instagram, levantar el poller); si se pierden, hay que
# reescribirlas. Los scripts de analisis con datos reales siguen ignorados.
!scripts/bot-*.mjs
!scripts/telegram-*.mjs
!scripts/instagram-*.mjs

# Worktrees de git creados por el agente. Son repos embebidos: si entran al
# índice, git los commitea como gitlink y el repo queda con una referencia rota
# para cualquiera que lo clone.
.claude/worktrees/
